{
  "name": "signage-control-panel-electron",
  "version": "1.0.0",
  "description": "Electron Desktop Client Wrapper untuk Signage Display - MJ Solution Indonesia",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:windowed": "cross-env KIOSK_MODE=false electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron": "^32.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mjsolution.signage-display",
    "productName": "Signage Display",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "pairing.html",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Signage Display"
    }
  }
}
